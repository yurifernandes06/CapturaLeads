# URL pública da aplicação (usada em links e webhooks)
APP_URL=http://localhost:3000

# Banco: SQLite local por padrão. Em produção use Turso (libsql://...)
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# SLA: segredo da rota /api/cron/sla e tick interno (padrão: ligado em dev/VPS, desligado na Vercel)
# Em produção, valores "troque-..." são recusados no boot.
CRON_SECRET=troque-este-segredo
SLA_INTERNAL_TICK=true

# API pública de captura (header x-api-key)
PUBLIC_API_KEY=troque-esta-chave

# WhatsApp: mock | cloud | evolution
WHATSAPP_PROVIDER=mock
WHATSAPP_WEBHOOK_TOKEN=troque-este-token

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_API_VERSION=v23.0

# Evolution API (self-hosted)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Opcional: rate limit compartilhado entre instâncias (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mídia do WhatsApp (imagens, áudios, documentos): Vercel Blob com store PRIVADO.
# Na Vercel, conectar o store ao projeto já injeta as credenciais (OIDC + BLOB_STORE_ID).
# Vazio = grava em data/media (só serve para dev/VPS).
BLOB_READ_WRITE_TOKEN=
